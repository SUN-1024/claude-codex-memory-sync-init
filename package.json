{
  "name": "repomemo",
  "version": "2.0.0",
  "description": "A minimal, Git-neutral continuity layer for agent-native project directories",
  "license": "MIT",
  "type": "module",
  "homepage": "https://github.com/SUN-1024/repomemo",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SUN-1024/repomemo.git"
  },
  "bugs": {
    "url": "https://github.com/SUN-1024/repomemo/issues"
  },
  "keywords": [
    "agents",
    "agent-native",
    "agents-md",
    "agent-skills",
    "codex",
    "claude-code",
    "gemini-cli",
    "opencode",
    "cursor",
    "copilot"
  ],
  "bin": {
    "repomemo": "dist/cli.js"
  },
  "files": [
    "dist/cli.js",
    "README.md",
    "README.zh.md",
    "MIGRATION-v1-v2.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "pnpm run build && node scripts/run-tests.mjs",
    "matrix": "node scripts/render-matrix.mjs",
    "matrix:check": "node scripts/render-matrix.mjs --check",
    "verify": "pnpm run typecheck && pnpm run test && pnpm run matrix:check",
    "package:smoke": "node scripts/package-smoke.mjs",
    "prepack": "pnpm run verify"
  },
  "devDependencies": {
    "@types/node": "^24.5.0",
    "esbuild": "^0.25.9",
    "typescript": "^5.9.2"
  }
}
